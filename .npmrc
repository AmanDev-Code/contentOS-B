# Force npm to accept the peerOptional conflict between
# @nestjs/platform-fastify@11.2.1 (wants @fastify/static@^10.1.2)
# and this project's pinned @fastify/static@^9.0.0.
#
# Without this flag, `npm install` fails with ERESOLVE in Docker
# builds (Coolify, CI) where you can't pass a CLI flag.
# Both @fastify/static v9 and v10 satisfy the runtime API surface
# NestJS actually uses, so accepting the conflict is safe.
legacy-peer-deps=true
